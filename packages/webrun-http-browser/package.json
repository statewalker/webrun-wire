{
  "name": "@statewalker/webrun-http-browser",
  "version": "0.6.5",
  "private": false,
  "type": "module",
  "description": "ServiceWorker-based HTTP server for browsers, with relay and same-origin dispatch modes",
  "bugs": {
    "url": "https://github.com/statewalker/webrun-wire/issues"
  },
  "homepage": "https://github.com/statewalker/webrun-wire/tree/main/packages/webrun-http-browser#readme",
  "author": {
    "name": "Mikhail Kotelnikov",
    "email": "mikhail.kotelnikov@gmail.com"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/statewalker/webrun-wire.git",
    "directory": "packages/webrun-http-browser"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./sw": {
      "source": "./src/sw.ts",
      "types": "./dist/sw.d.ts",
      "import": "./dist/sw.js"
    },
    "./relay-sw": {
      "default": "./dist/relay-sw.js"
    },
    "./relay-worker": {
      "source": "./src/relay-worker.ts",
      "types": "./dist/relay-worker.d.ts",
      "import": "./dist/relay-worker.js"
    },
    "./sw-worker": {
      "default": "./dist/sw-worker.js"
    }
  },
  "files": [
    "dist",
    "src",
    "public",
    "public-relay",
    "demo"
  ],
  "scripts": {
    "build": "rimraf dist && rolldown -c && tsc --emitDeclarationOnly --declaration",
    "prepack": "pnpm run build",
    "test": "vitest run",
    "test:browser": "pnpm run build && vitest run --config vitest.browser.config.ts",
    "lint": "biome check src tests",
    "serve": "http-server -p 5173 -c-1 -s .",
    "example:same-origin": "pnpm run build && http-server -p 5173 -c-1 -o /public/index.html .",
    "example:relay-site": "pnpm run build && http-server -p 5173 -c-1 -o /demo/demo-1.html .",
    "example:relay-files": "pnpm run build && http-server -p 5173 -c-1 -o /demo/demo-2.html .",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@statewalker/webrun-http-streams": "workspace:^",
    "@statewalker/webrun-rpc": "workspace:^",
    "@statewalker/webrun-streams": "workspace:^",
    "idb-keyval": "catalog:"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@types/node": "catalog:",
    "http-server": "catalog:",
    "playwright": "catalog:",
    "rimraf": "catalog:",
    "rolldown": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  }
}
