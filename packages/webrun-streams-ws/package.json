{
  "name": "@statewalker/webrun-streams-ws",
  "version": "0.2.2",
  "private": false,
  "type": "module",
  "description": "WebSocket-backed Connect/Serve adapter in the webrun-streams-* family",
  "bugs": {
    "url": "https://github.com/statewalker/webrun-wire/issues"
  },
  "homepage": "https://github.com/statewalker/webrun-wire/tree/main/packages/webrun-streams-ws#readme",
  "author": {
    "name": "Mikhail Kotelnikov",
    "email": "mikhail.kotelnikov@gmail.com"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/statewalker/webrun-wire.git",
    "directory": "packages/webrun-streams-ws"
  },
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "rimraf dist && rolldown -c && tsc --emitDeclarationOnly --declaration",
    "test": "vitest run",
    "test:bench": "vitest run --config vitest.bench.config.ts --reporter=verbose",
    "typecheck": "tsc --noEmit",
    "typecheck:tests": "tsc -p tsconfig.tests.json",
    "lint": "biome check src tests",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@statewalker/webrun-streams": "workspace:^"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@statewalker/webrun-streams-conformance": "workspace:^",
    "@types/node": "catalog:",
    "@types/ws": "catalog:",
    "rimraf": "catalog:",
    "rolldown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "ws": "catalog:"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "types": "./dist/index.d.ts"
}
