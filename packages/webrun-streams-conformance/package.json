{
  "name": "@statewalker/webrun-streams-conformance",
  "version": "0.3.2",
  "private": false,
  "type": "module",
  "description": "Conformance test suite for Duplex/Connect/Serve adapters in the webrun-streams-* family",
  "bugs": {
    "url": "https://github.com/statewalker/webrun-wire/issues"
  },
  "homepage": "https://github.com/statewalker/webrun-wire/tree/main/packages/webrun-streams-conformance#readme",
  "author": {
    "name": "Mikhail Kotelnikov",
    "email": "mikhail.kotelnikov@gmail.com"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/statewalker/webrun-wire.git",
    "directory": "packages/webrun-streams-conformance"
  },
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "rimraf dist && rolldown -c && tsc --emitDeclarationOnly --declaration",
    "test": "vitest run",
    "lint": "biome check src tests",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@statewalker/webrun-streams": "workspace:^",
    "vitest": "catalog:"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@types/node": "catalog:",
    "rimraf": "catalog:",
    "rolldown": "catalog:",
    "typescript": "catalog:"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "types": "./dist/index.d.ts"
}
