{
  "name": "@statewalker/webrun-streams-peerjs",
  "version": "0.2.0",
  "private": false,
  "type": "module",
  "description": "PeerJS DataConnection-backed Connect/Serve adapter in the webrun-streams-* family",
  "homepage": "https://github.com/statewalker/webrun-wire",
  "author": {
    "name": "Mikhail Kotelnikov",
    "email": "mikhail.kotelnikov@gmail.com"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git@github.com:statewalker/webrun-wire.git"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "rimraf dist && rolldown -c && tsc --emitDeclarationOnly --declaration",
    "test": "vitest run",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "lint": "biome check src tests",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@statewalker/webrun-streams": "workspace:^"
  },
  "peerDependencies": {
    "peerjs": "catalog:peers"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@roamhq/wrtc": "catalog:",
    "@statewalker/webrun-streams-conformance": "workspace:^",
    "@types/node": "catalog:",
    "@vitest/browser-playwright": "catalog:",
    "peer": "catalog:",
    "peerjs": "catalog:",
    "playwright": "catalog:",
    "rimraf": "catalog:",
    "rolldown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "types": "./dist/index.d.ts"
}
