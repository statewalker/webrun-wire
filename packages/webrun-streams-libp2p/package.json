{
  "name": "@statewalker/webrun-streams-libp2p",
  "version": "0.1.1",
  "private": false,
  "type": "module",
  "description": "libp2p native multi-stream Connect/Serve adapter in the webrun-streams-* family",
  "homepage": "https://github.com/statewalker/webrun-wire",
  "author": {
    "name": "Mikhail Kotelnikov",
    "email": "mikhail.kotelnikov@gmail.com"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git@github.com:statewalker/webrun-wire.git"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "rimraf dist && rolldown -c && tsc --emitDeclarationOnly --declaration",
    "test": "vitest run",
    "lint": "biome check src tests",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@statewalker/webrun-streams": "workspace:*"
  },
  "peerDependencies": {
    "@libp2p/interface": "^3.0.0",
    "@multiformats/multiaddr": "^13.0.0",
    "libp2p": "^3.0.0"
  },
  "peerDependenciesMeta": {
    "libp2p": {
      "optional": true
    }
  },
  "devDependencies": {
    "@chainsafe/libp2p-noise": "17.0.0",
    "@chainsafe/libp2p-yamux": "8.0.1",
    "@libp2p/interface": "3.2.5",
    "@libp2p/tcp": "11.0.26",
    "@libp2p/utils": "7.3.2",
    "@multiformats/multiaddr": "13.0.3",
    "@statewalker/webrun-streams-conformance": "workspace:*",
    "@types/node": "catalog:",
    "libp2p": "3.3.8",
    "rimraf": "catalog:",
    "rolldown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "types": "./dist/index.d.ts"
}
