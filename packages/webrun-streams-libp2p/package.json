{
  "name": "@statewalker/webrun-streams-libp2p",
  "version": "0.1.7",
  "private": false,
  "type": "module",
  "description": "libp2p native multi-stream Connect/Serve adapter in the webrun-streams-* family",
  "bugs": {
    "url": "https://github.com/statewalker/webrun-wire/issues"
  },
  "homepage": "https://github.com/statewalker/webrun-wire/tree/main/packages/webrun-streams-libp2p#readme",
  "author": {
    "name": "Mikhail Kotelnikov",
    "email": "mikhail.kotelnikov@gmail.com"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/statewalker/webrun-wire.git",
    "directory": "packages/webrun-streams-libp2p"
  },
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "rimraf dist && rolldown -c && tsc --emitDeclarationOnly --declaration",
    "test": "vitest run",
    "lint": "biome check src tests",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@statewalker/webrun-streams": "workspace:^"
  },
  "peerDependencies": {
    "@libp2p/interface": "catalog:peers",
    "@multiformats/multiaddr": "catalog:peers",
    "libp2p": "catalog:peers"
  },
  "peerDependenciesMeta": {
    "libp2p": {
      "optional": true
    }
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@chainsafe/libp2p-noise": "catalog:",
    "@chainsafe/libp2p-yamux": "catalog:",
    "@libp2p/interface": "catalog:",
    "@libp2p/tcp": "catalog:",
    "@libp2p/utils": "catalog:",
    "@multiformats/multiaddr": "catalog:",
    "@statewalker/webrun-streams-conformance": "workspace:^",
    "@types/node": "catalog:",
    "libp2p": "catalog:",
    "rimraf": "catalog:",
    "rolldown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "types": "./dist/index.d.ts"
}
