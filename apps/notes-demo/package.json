{
  "name": "@statewalker/notes-demo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "App-agnostic in-browser runner (webrun-modules → SiteBuilder → same-origin SW) with a notes CRUD example payload authored as real TS/TSX.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 5177",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc --noEmit -p src/app/tsconfig.json"
  },
  "dependencies": {
    "@statewalker/webrun-files": "catalog:",
    "@statewalker/webrun-files-browser": "catalog:",
    "@statewalker/webrun-files-mem": "catalog:",
    "@statewalker/webrun-modules": "workspace:*",
    "@statewalker/webrun-http-browser": "workspace:*",
    "@statewalker/webrun-site-builder": "workspace:*",
    "@statewalker/webrun-site-host": "workspace:*"
  },
  "devDependencies": {
    "@types/lodash.debounce": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "lodash.debounce": "catalog:",
    "marked": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
