{
  "name": "@statewalker/webrun-wire-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.16.1",
  "description": "Transport-agnostic HTTP, RPC, and streaming primitives for the webrun ecosystem - monorepo",
